@startuml
title Modelo conceptual UML - Plataforma colaborativa Q&A

skinparam classAttributeIconSize 0
skinparam linetype ortho
left to right direction

' =========================
' Autoría y usuarios
' =========================

interface Autor {
  + getId(): UUID
  + getNombreVisible(): String
}

abstract class Usuario {
  - id: UUID
  - email: String
  - passwordHash: String
  - nombreVisible: String
  - fechaRegistro: LocalDateTime
  + verificarContrasena(password: String): Boolean
  + publicarPregunta(pregunta: Pregunta): void
  + votar(votable: Votable, tipo: TipoVoto): Voto
}

class UsuarioGeneral
class Administrador {
  + moderarPregunta(pregunta: Pregunta): void
  + moderarRespuesta(respuesta: Respuesta): void
}

class AgenteIA {
  - id: UUID
  - nombreVisible: String
  - proveedor: String
  - modelo: String
  - activo: Boolean
}

Autor <|.. Usuario
Autor <|.. AgenteIA
Usuario <|-- UsuarioGeneral
Usuario <|-- Administrador

' =========================
' Contenido del dominio
' =========================

class Pregunta {
  - id: UUID
  - titulo: String
  - cuerpoEnriquecido: String
  - fechaPublicacion: LocalDateTime
  - cerrada: Boolean
  + agregarRespuesta(respuesta: Respuesta): void
  + aceptarRespuesta(respuesta: Respuesta, solicitante: Usuario): void
  + agregarEtiqueta(etiqueta: Etiqueta): void
  + tieneRespuestas(): Boolean
  + agregarVoto(voto: Voto): void
  + calcularPuntuacion(): int
}

class Respuesta {
  - id: UUID
  - cuerpoEnriquecido: String
  - fechaPublicacion: LocalDateTime
  - aceptada: Boolean
  + marcarComoAceptada(): void
  + desmarcarComoAceptada(): void
  + agregarVoto(voto: Voto): void
  + calcularPuntuacion(): int
}

class Categoria {
  - id: UUID
  - nombre: String
  - descripcion: String
}

class Etiqueta {
  - id: UUID
  - nombre: String
}

Pregunta "0..*" --> "1" Usuario : autor >
Pregunta "1" *-- "0..*" Respuesta : respuestas >
Respuesta "0..*" --> "1" Autor : autor >
Pregunta "0..*" --> "1" Categoria : categoría >
Pregunta "0..*" -- "0..*" Etiqueta : etiquetas >

note right of Pregunta
  Una pregunta pertenece obligatoriamente
  a una única categoría y puede tener
  varias etiquetas.

  Solo su autor puede aceptar una respuesta.
  Como máximo habrá una respuesta aceptada
  por pregunta.
end note

note bottom of Respuesta
  La respuesta conoce únicamente la abstracción Autor.
  No necesita distinguir entre usuarios humanos
  y agentes de IA.
end note

' =========================
' Votación polimórfica
' =========================

interface Votable {
  + agregarVoto(voto: Voto): void
  + calcularPuntuacion(): int
}

class Voto {
  - id: UUID
  - tipo: TipoVoto
  - fecha: LocalDateTime
  + getValor(): int
}

enum TipoVoto {
  POSITIVO
  NEGATIVO
}

Votable <|.. Pregunta
Votable <|.. Respuesta
Voto "0..*" --> "1" Usuario : emisor >
Voto "0..*" --> "1" Votable : objetivo >
Voto --> TipoVoto

note bottom of Voto
  Restricción: un usuario registrado puede emitir
  como máximo un voto sobre cada pregunta
  o respuesta. Un voto positivo vale +1
  y uno negativo vale -1.
end note

' =========================
' Factory Method de autoría
' =========================

abstract class FabricaAutor {
  + {abstract} crearAutor(): Autor
}

class FabricaUsuarioGeneral {
  - email: String
  - passwordHash: String
  - nombreVisible: String
  + crearAutor(): Autor
}

class FabricaAdministrador {
  - email: String
  - passwordHash: String
  - nombreVisible: String
  + crearAutor(): Autor
}

class FabricaAgenteIA {
  - nombreVisible: String
  - proveedor: String
  - modelo: String
  + crearAutor(): Autor
}

FabricaAutor <|-- FabricaUsuarioGeneral
FabricaAutor <|-- FabricaAdministrador
FabricaAutor <|-- FabricaAgenteIA

FabricaUsuarioGeneral ..> UsuarioGeneral : crea >
FabricaAdministrador ..> Administrador : crea >
FabricaAgenteIA ..> AgenteIA : crea >

' =========================
' Strategy para proveedores LLM
' =========================

interface EstrategiaGeneracionLLM {
  + generarRespuesta(pregunta: Pregunta): String
}

class EstrategiaOpenAI {
  - apiKey: String
  - modelo: String
  + generarRespuesta(pregunta: Pregunta): String
}

class EstrategiaGemini {
  - apiKey: String
  - modelo: String
  + generarRespuesta(pregunta: Pregunta): String
}

class EstrategiaModeloLocal {
  - endpoint: String
  - modelo: String
  + generarRespuesta(pregunta: Pregunta): String
}

EstrategiaGeneracionLLM <|.. EstrategiaOpenAI
EstrategiaGeneracionLLM <|.. EstrategiaGemini
EstrategiaGeneracionLLM <|.. EstrategiaModeloLocal

class ServicioRespuestasAutomaticas {
  - etiquetaActivadora: String = "#ia-help"
  - tiempoMaximoSinRespuesta: Duration
  - estrategia: EstrategiaGeneracionLLM
  + cambiarEstrategia(estrategia: EstrategiaGeneracionLLM): void
  + debeResponder(pregunta: Pregunta): Boolean
  + generarRespuesta(pregunta: Pregunta): Respuesta
}

ServicioRespuestasAutomaticas o--> EstrategiaGeneracionLLM : estrategia >
ServicioRespuestasAutomaticas ..> FabricaAgenteIA : obtiene el autor >
ServicioRespuestasAutomaticas ..> Respuesta : crea >
ServicioRespuestasAutomaticas ..> Pregunta : evalúa >

note bottom of ServicioRespuestasAutomaticas
  Activa la generación si la pregunta contiene
  la etiqueta configurada o si supera el tiempo
  máximo sin respuestas.

  La estrategia se inyecta y puede reemplazarse
  sin modificar este servicio ni las entidades
  del dominio.
end note

@enduml
